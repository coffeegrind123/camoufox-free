 GENERATE_COORDS_WRAPPED_GETTER_NULLABLE(Speed)
 
 #undef GENERATE_COORDS_WRAPPED_GETTER
 #undef GENERATE_COORDS_WRAPPED_GETTER_NULLABLE
 
+// Camoufox: no device reports an accuracy of 0, which is what a position given
+// without one carries (Playwright's geolocation option, or geolocation:* without
+// geolocation:accuracy). Estimate it from the coordinates' precision: the width
+// of their last decimal place, a degree of longitude being 111,320 m at the
+// equator.
+double GeolocationCoordinates::Accuracy() const {
+  double rv;
+  mCoords->GetAccuracy(&rv);
+  if (rv > 0) {
+    return rv;
+  }
+  auto decimals = [](double aValue) {
+    nsAutoCString digits;
+    digits.AppendFloat(aValue);
+    int32_t dot = digits.FindChar('.');
+    return dot == kNotFound ? 0 : int32_t(digits.Length()) - dot - 1;
+  };
+  const double latitude = Latitude();
+  const int32_t precision =
+      std::min(decimals(latitude), decimals(Longitude()));
+  return 111320 * std::cos(latitude * 3.141592653589793 / 180) /
+         std::pow(10, precision);
+}
+
 }  // namespace mozilla::dom
