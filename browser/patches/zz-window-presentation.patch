+/* static */
+Maybe<nsGlobalWindowInner::PresentedWindow> nsGlobalWindowInner::PresentWindow(
+    BrowsingContext* aContext) {
+  MOZ_ASSERT(NS_IsMainThread());
+  const Maybe<CSSIntMargin>& frame = ClaimedWindowFrame();
+  if (!frame || !aContext) {
+    return Nothing();
+  }
+  BrowsingContext* top = aContext->Top();
+  const CSSIntRect content = top->GetCamouContentRect();
+  if (content.IsEmpty()) {
+    return Nothing();
+  }
+  // Stock Firefox has no frame in fullscreen: outer is inner, at the screen's
+  // origin.
+  if (top->GetCamouFullscreen()) {
+    return Some(PresentedWindow{CSSIntMargin(), Some(CSSIntPoint(0, 0)), content});
+  }
+
+  // The launch state, read once: the config never changes in a process.
+  // window.frameTop is the frame the window launched with, which includes
+  // window.frameBorderTop when it launched maximized (window.maximized).
+  struct Launch {
+    int32_t mBorderTop = 0;
+    bool mMaximized = false;
+    std::optional<int32_t> mX, mY;
+    std::optional<std::array<uint32_t, 4>> mAvail;
+  };
+  static const Launch sLaunch = [] {
+    Launch launch;
+    launch.mBorderTop =
+        int32_t(MaskConfig::GetUint32("window.frameBorderTop").value_or(0));
+    launch.mMaximized = MaskConfig::GetBool("window.maximized");
+    launch.mX = MaskConfig::GetInt32("window.screenX");
+    launch.mY = MaskConfig::GetInt32("window.screenY");
+    launch.mAvail = MaskConfig::GetRect("screen.availLeft", "screen.availTop",
+                                        "screen.availWidth",
+                                        "screen.availHeight");
+    return launch;
+  }();
+
+  const int32_t toolbars =
+      frame->top.value - (sLaunch.mMaximized ? sLaunch.mBorderTop : 0);
+
+  // Maximized as stock presents it on Windows: the window is the available
+  // area plus its resize borders, which hang off the screen's edges, so the
+  // top border sits above the toolbars. A window counts as maximized when the
+  // real one is, or when its content fills the claimed available area, as a
+  // launch drawn maximized does (the real window is not WM-maximized there).
+  // A user's resize leaves it, and the window then has the normal frame.
+  if (sLaunch.mBorderTop > 0 && sLaunch.mAvail) {
+    const auto& avail = *sLaunch.mAvail;
+    const int32_t availLeft = int32_t(avail[0]);
+    const int32_t availTop = int32_t(avail[1]);
+    const bool fills = content.width == int32_t(avail[2]) &&
+                       content.height == int32_t(avail[3]) - toolbars;
+    if (top->GetCamouMaximized() || fills) {
+      return Some(PresentedWindow{
+          CSSIntMargin(toolbars + sLaunch.mBorderTop, frame->right.value,
+                       frame->bottom.value, frame->left.value),
+          Some(CSSIntPoint(availLeft - frame->left.value,
+                           availTop - sLaunch.mBorderTop)),
+          content});
+    }
+  }
+
+  // A normal window. One that launched maximized has no remembered normal
+  // place, so it sits at the available area's origin.
+  Maybe<CSSIntPoint> position;
+  if (sLaunch.mMaximized && sLaunch.mAvail) {
+    position = Some(CSSIntPoint(int32_t((*sLaunch.mAvail)[0]),
+                                int32_t((*sLaunch.mAvail)[1])));
+  } else if (sLaunch.mX && sLaunch.mY) {
+    position = Some(CSSIntPoint(*sLaunch.mX, *sLaunch.mY));
+  }
+  return Some(PresentedWindow{
+      CSSIntMargin(toolbars, frame->right.value, frame->bottom.value,
+                   frame->left.value),
+      position, content});
+}
