+// The URIs of the registered voices the window's pages see, in the order
+// getVoices() reports them: the registry's, or the context's own
+// (SpeechVoicesManager).
+static void VisibleVoiceUris(nsPIDOMWindowInner* aWindow,
+                             nsTArray<nsString>& aUris) {
+  nsSynthVoiceRegistry* registry = nsSynthVoiceRegistry::GetInstance();
+  uint32_t voiceCount = 0;
+  if (NS_WARN_IF(NS_FAILED(registry->GetVoiceCount(&voiceCount)))) {
+    return;
+  }
+
+  const uint32_t userContextId = RoverfoxStorageManager::UserContextId(aWindow);
+  nsTArray<std::pair<int32_t, nsString>> voices;
+  for (uint32_t i = 0; i < voiceCount; i++) {
+    nsAutoString uri;
+    if (NS_FAILED(registry->GetVoice(i, uri))) {
+      NS_WARNING("Failed to retrieve voice from registry");
+      continue;
+    }
+
+    nsAutoString name;
+    registry->GetVoiceName(uri, name);
+    const int32_t index =
+        SpeechVoicesManager::VoiceIndex(userContextId, name, uri);
+    if (index >= 0) {
+      voices.AppendElement(std::make_pair(index, nsString(uri)));
+    }
+  }
+
+  voices.StableSort([](const auto& aLeft, const auto& aRight) {
+    return aLeft.first < aRight.first ? -1 : aLeft.first > aRight.first;
+  });
+  for (const auto& voice : voices) {
+    aUris.AppendElement(voice.second);
+  }
+}
