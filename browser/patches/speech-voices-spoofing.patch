diff --git a/dom/base/SpeechVoicesManager.cpp b/dom/base/SpeechVoicesManager.cpp
new file mode 100644
index 0000000000..2356b7ca17
--- /dev/null
+++ b/dom/base/SpeechVoicesManager.cpp
@@ -0,0 +1,110 @@
+/* Camoufox: Per-context speech voices manager */
+#include "SpeechVoicesManager.h"
+
+#include "mozilla/Mutex.h"
+#include "MaskConfig.hpp"
+
+namespace mozilla {
+namespace dom {
+
+// The list itself lives in RoverfoxStorageManager, which every process reads:
+// a context's documents land in any content process, and only the first one
+// calls the setter. This is each process's parsed copy.
+static mozilla::Mutex sVoicesMutex("SpeechVoicesManager");
+static nsTHashMap<nsUint32HashKey, nsTArray<nsString>> sVoicesMap;
+
+static nsString VoiceListKey(uint32_t aId) {
+  nsAutoString key;
+  key.AppendPrintf("spvoices_%u", aId);
+  return key;
+}
+
+static nsTArray<nsString> ParseVoices(const nsAString& aVoiceList) {
+  nsTArray<nsString> voices;
+  // One name per line: Windows voice names hold commas ("Microsoft Hanhan -
+  // Chinese (Traditional, Taiwan)").
+  nsAutoString remaining(aVoiceList);
+  while (!remaining.IsEmpty()) {
+    int32_t newline = remaining.FindChar('\n');
+    nsAutoString name;
+    if (newline >= 0) {
+      name = Substring(remaining, 0, newline);
+      remaining = Substring(remaining, newline + 1);
+    } else {
+      name = remaining;
+      remaining.Truncate();
+    }
+    name.Trim(" \t");
+    if (!name.IsEmpty() && !voices.Contains(name)) {
+      voices.AppendElement(name);
+    }
+  }
+  return voices;
+}
+
+void SpeechVoicesManager::SetVoices(uint32_t aUserContextId,
+                                     const nsAString& aVoiceList) {
+  RoverfoxStorageManager::PutString(VoiceListKey(aUserContextId), aVoiceList);
+  MutexAutoLock lock(sVoicesMutex);
+  sVoicesMap.InsertOrUpdate(aUserContextId, ParseVoices(aVoiceList));
+}
+
+// Parses the context's list into this process's copy the first time it is
+// needed. An absent list is not remembered: another process may set it later.
+static bool EnsureVoices(uint32_t aId) {
+  {
+    MutexAutoLock lock(sVoicesMutex);
+    if (sVoicesMap.Contains(aId)) return true;
+  }
+  nsAutoString list;
+  if (!RoverfoxStorageManager::GetString(VoiceListKey(aId), list)) return false;
+  MutexAutoLock lock(sVoicesMutex);
+  sVoicesMap.InsertOrUpdate(aId, ParseVoices(list));
+  return true;
+}
+
+// The URIs of the launch's own voices while the registry also holds the
+// voices of "voices:pool" (voice-spoofing.patch), which only a context that
+// lists them sees. Nothing without a pool.
+static const std::optional<nsTHashSet<nsString>>& LaunchVoices() {
+  static const std::optional<nsTHashSet<nsString>> sLaunch =
+      []() -> std::optional<nsTHashSet<nsString>> {
+    auto voices = MaskConfig::MVoices();
+    if (!voices || !MaskConfig::MVoices("voices:pool")) return std::nullopt;
+    nsTHashSet<nsString> uris;
+    for (const auto& voice : *voices) {
+      uris.Insert(NS_ConvertUTF8toUTF16(std::get<2>(voice)));
+    }
+    return uris;
+  }();
+  return sLaunch;
+}
+
+bool SpeechVoicesManager::ScopesVoices(uint32_t aUserContextId) {
+  return LaunchVoices() || EnsureVoices(aUserContextId);
+}
+
+int32_t SpeechVoicesManager::VoiceIndex(uint32_t aUserContextId,
+                                        const nsAString& aVoiceName,
+                                        const nsAString& aVoiceUri) {
+  if (!EnsureVoices(aUserContextId)) {
+    const auto& launch = LaunchVoices();
+    return !launch || launch->Contains(aVoiceUri) ? INT32_MAX : -1;
+  }
+  MutexAutoLock lock(sVoicesMutex);
+  const size_t index =
+      sVoicesMap.Lookup(aUserContextId).Data().IndexOf(aVoiceName);
+  return index == nsTArray<nsString>::NoIndex ? -1 : int32_t(index);
+}
+
+void SpeechVoicesManager::DisableFunction(uint32_t aId) {
+  RoverfoxStorageManager::MarkSetterUsed("spvoices", aId);
+}
+
+bool SpeechVoicesManager::IsFunctionEnabledForWebIDL(JSContext* aCx,
+                                                      JSObject* aObj) {
+  return RoverfoxStorageManager::IsSetterOffered(aObj, "spvoices");
+}
+
+}  // namespace dom
+}  // namespace mozilla
