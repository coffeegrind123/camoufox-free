+bool ContentParent::GetAppLocales(nsTArray<nsCString>& aLocales) const {
+  LocaleService* localeService = LocaleService::GetInstance();
+  localeService->GetAppLocalesAsBCP47(aLocales);
+  nsAutoCString locale;
+  if (!NavigatorManager::GetLocale(mRemoteType.UserContextId(), locale) ||
+      locale.IsEmpty()) {
+    return false;
+  }
+
+  // A language list ("de, en-US, en") is the context's preference order.
+  nsTArray<nsCString> requested;
+  for (const nsACString& tag :
+       nsCCharSeparatedTokenizer(locale, ',').ToRange()) {
+    requested.AppendElement(tag);
+  }
+  AutoTArray<nsCString, 100> available;
+  nsAutoCString fallback;
+  localeService->GetAvailableLocales(available);
+  localeService->GetLastFallbackLocale(fallback);
+  nsTArray<nsCString> negotiated;
+  localeService->NegotiateLanguages(requested, available, fallback,
+                                    LocaleService::kLangNegStrategyFiltering,
+                                    negotiated);
+  if (negotiated.IsEmpty() || negotiated == aLocales) {
+    return false;
+  }
+  aLocales = std::move(negotiated);
+  return true;
+}
+
+/* static */
+void ContentParent::UpdateContextLocale(uint32_t aUserContextId) {
+  nsCOMPtr<nsIChromeRegistry> registrySvc = nsChromeRegistry::GetService();
+  nsChromeRegistryChrome* chromeRegistry =
+      static_cast<nsChromeRegistryChrome*>(registrySvc.get());
+  for (auto* cp : AllProcesses(eLive)) {
+    if (cp->mRemoteType.UserContextId() != aUserContextId) {
+      continue;
+    }
+
+    chromeRegistry->SendRegisteredChrome(cp);
+    nsTArray<nsCString> locales;
+    cp->GetAppLocales(locales);
+    NS_WARNING_ASSERTION(!locales.IsEmpty(),
+                         "a content process has no app locale");
+    if (!locales.IsEmpty()) {
+      const bool sent = cp->SendUpdateAppLocales(locales);
+      NS_WARNING_ASSERTION(sent, "failed to update a context's app locale");
+    }
+  }
+}
