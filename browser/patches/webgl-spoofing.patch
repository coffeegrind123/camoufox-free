+uint32_t ClientWebGLContext::GetUserContextId() const {
+  if (mCanvasElement) {
+    return dom::RoverfoxStorageManager::UserContextId(mCanvasElement);
+  }
+  if (mOffscreenCanvas) {
+    nsCOMPtr<nsPIDOMWindowInner> win =
+        do_QueryInterface(mOffscreenCanvas->GetParentObject());
+    if (win) {
+      return dom::RoverfoxStorageManager::UserContextId(win);
+    }
+    if (dom::WorkerPrivate* wp = dom::GetCurrentThreadWorkerPrivate()) {
+      return wp->GetOriginAttributes().mUserContextId;
+    }
+  }
+  return 0;
+}
+
+const MaskConfig::WebGLTables* ClientWebGLContext::CamouWebGLTables() const {
+  if (mCamouWebGLTables) {
+    return mCamouWebGLTables.get();
+  }
+  // A memoized read: a context without tables (the launch identity) pays one
+  // lookup per call and takes no lock.
+  nsAutoString stored;
+  const uint32_t userContextId = GetUserContextId();
+  if (!dom::WebGLParamsManager::GetConfig(userContextId, stored)) {
+    return nullptr;
+  }
+
+  // Parsed and indexed once per browsing context and process, not once per
+  // WebGL context: a page can create contexts in a loop, and the first
+  // getParameter of each would otherwise parse the whole table.
+  struct Parsed {
+    std::string mSource;
+    std::shared_ptr<const MaskConfig::WebGLTables> mTables;
+  };
+  static StaticMutex sMutex MOZ_UNANNOTATED;
+  static std::unordered_map<uint32_t, Parsed> sParsed;
+
+  const NS_ConvertUTF16toUTF8 source(stored);
+  {
+    StaticMutexAutoLock lock(sMutex);
+    const auto found = sParsed.find(userContextId);
+    if (found != sParsed.end() &&
+        found->second.mSource == std::string_view(source.get(), source.Length())) {
+      mCamouWebGLTables = found->second.mTables;
+      return mCamouWebGLTables.get();
+    }
+  }
+  auto parsed = nlohmann::json::parse(source.get(), nullptr, false);
+  if (!parsed.is_object()) {
+    return nullptr;
+  }
+  auto tables = std::make_shared<const MaskConfig::WebGLTables>(std::move(parsed));
+  {
+    StaticMutexAutoLock lock(sMutex);
+    sParsed.insert_or_assign(
+        userContextId,
+        Parsed{std::string(source.get(), source.Length()), tables});
+  }
+  mCamouWebGLTables = std::move(tables);
+  return mCamouWebGLTables.get();
+}
