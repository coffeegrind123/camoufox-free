+/* Camoufox: Per-context WebGL parameter manager */
+#include "WebGLParamsManager.h"
+#include "json.hpp"
+
+namespace mozilla {
+namespace dom {
+
+void WebGLParamsManager::SetVendor(uint32_t aId, const nsAString& aValue) {
+  nsAutoString key;
+  key.AppendPrintf("webgl_vendor_%u", aId);
+  RoverfoxStorageManager::PutString(key, aValue);
+}
+
+bool WebGLParamsManager::GetVendor(uint32_t aId, nsAString& aOut) {
+  return RoverfoxStorageManager::GetString("webgl_vendor_", aId, aOut);
+}
+
+void WebGLParamsManager::SetRenderer(uint32_t aId, const nsAString& aValue) {
+  nsAutoString key;
+  key.AppendPrintf("webgl_renderer_%u", aId);
+  RoverfoxStorageManager::PutString(key, aValue);
+}
+
+bool WebGLParamsManager::GetRenderer(uint32_t aId, nsAString& aOut) {
+  return RoverfoxStorageManager::GetString("webgl_renderer_", aId, aOut);
+}
+
+bool WebGLParamsManager::SetConfig(uint32_t aId, const nsAString& aJson) {
+  const auto parsed =
+      nlohmann::json::parse(NS_ConvertUTF16toUTF8(aJson).get(), nullptr, false);
+  if (!parsed.is_object()) {
+    return false;
+  }
+  nsAutoString key;
+  key.AppendPrintf("webgl_config_%u", aId);
+  RoverfoxStorageManager::PutString(key, aJson);
+  return true;
+}
+
+bool WebGLParamsManager::GetConfig(uint32_t aId, nsAString& aOut) {
+  return RoverfoxStorageManager::GetString("webgl_config_", aId, aOut);
+}
+
+void WebGLParamsManager::DisableVendorFunction(uint32_t aId) {
+  RoverfoxStorageManager::MarkSetterUsed("webgl_v", aId);
+}
+
+void WebGLParamsManager::DisableRendererFunction(uint32_t aId) {
+  RoverfoxStorageManager::MarkSetterUsed("webgl_r", aId);
+}
+
+void WebGLParamsManager::DisableConfigFunction(uint32_t aId) {
+  RoverfoxStorageManager::MarkSetterUsed("webgl_c", aId);
+}
+
+bool WebGLParamsManager::IsVendorFunctionEnabledForWebIDL(JSContext* aCx,
+                                                           JSObject* aObj) {
+  return RoverfoxStorageManager::IsSetterOffered(aObj, "webgl_v");
+}
+
+bool WebGLParamsManager::IsRendererFunctionEnabledForWebIDL(JSContext* aCx,
+                                                             JSObject* aObj) {
+  return RoverfoxStorageManager::IsSetterOffered(aObj, "webgl_r");
+}
+
+bool WebGLParamsManager::IsConfigFunctionEnabledForWebIDL(JSContext* aCx,
+                                                           JSObject* aObj) {
+  return RoverfoxStorageManager::IsSetterOffered(aObj, "webgl_c");
+}
+
+}  // namespace dom
+}  // namespace mozilla
