@@ -0,0 +1,38 @@
+/* Camoufox: Per-context WebGL parameter manager */
+#ifndef mozilla_dom_WebGLParamsManager_h
+#define mozilla_dom_WebGLParamsManager_h
+
+#include "nsString.h"
+#include "RoverfoxStorageManager.h"
+
+namespace mozilla {
+namespace dom {
+
+class WebGLParamsManager {
+ public:
+  static void SetVendor(uint32_t aId, const nsAString& aValue);
+  static bool GetVendor(uint32_t aId, nsAString& aOut);
+  static void SetRenderer(uint32_t aId, const nsAString& aValue);
+  static bool GetRenderer(uint32_t aId, nsAString& aOut);
+  // The context's own WebGL tables: a JSON object of the webGl:* and webGl2:*
+  // config keys of the GPU it names with SetVendor/SetRenderer. Without them a
+  // context of another GPU reported the launch GPU's limits, extensions and
+  // shader precisions beside its own renderer. SetConfig refuses anything but
+  // a JSON object; GetConfig is false for a context without tables, which
+  // keeps the launch's. WebIDL bindings include this header, so it stays free
+  // of the JSON library: ClientWebGLContext parses the tables.
+  static bool SetConfig(uint32_t aId, const nsAString& aJson);
+  static bool GetConfig(uint32_t aId, nsAString& aOut);
+  static void DisableVendorFunction(uint32_t aId);
+  static void DisableRendererFunction(uint32_t aId);
+  static void DisableConfigFunction(uint32_t aId);
+  static bool IsVendorFunctionEnabledForWebIDL(JSContext* aCx, JSObject* aObj);
+  static bool IsRendererFunctionEnabledForWebIDL(JSContext* aCx,
+                                                  JSObject* aObj);
+  static bool IsConfigFunctionEnabledForWebIDL(JSContext* aCx, JSObject* aObj);
+};
+
+}  // namespace dom
+}  // namespace mozilla
+
+#endif  // mozilla_dom_WebGLParamsManager_h
