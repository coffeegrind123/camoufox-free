+// Camoufox: stock Firefox keys proxy credentials by proxy host:port alone, so
+// every browser context shares one entry. Automation that gives contexts the
+// same proxy with different credentials (per-session gateway usernames) then
+// sends one context's traffic with another's login, or has an entry replaced
+// mid-handshake and fails with 407. Key the entry by the context instead. Only
+// the container and private-browsing ids are used: the network partition key
+// would force a fresh 407 round trip for every top-level site. The default
+// context has an empty suffix, which is the stock behaviour.
+static void GetProxyAuthOriginAttributesSuffix(nsIChannel* aChan,
+                                               nsACString& aSuffix) {
+  OriginAttributes oa;
+  if (aChan) {
+    OriginAttributes channelOA;
+    StoragePrincipalHelper::GetOriginAttributesForNetworkState(aChan,
+                                                               channelOA);
+    oa.mUserContextId = channelOA.mUserContextId;
+    oa.mPrivateBrowsingId = channelOA.mPrivateBrowsingId;
+  }
+
+  oa.CreateSuffix(aSuffix);
+}
