diff --git a/dom/base/nsGlobalWindowOuter.cpp b/dom/base/nsGlobalWindowOuter.cpp
index 7efb9483ea..c8d9959127 100644
--- a/dom/base/nsGlobalWindowOuter.cpp
+++ b/dom/base/nsGlobalWindowOuter.cpp
@@ -3614,8 +3614,33 @@ CSSIntSize nsGlobalWindowOuter::GetOuterSize(CallerType aCallerType,
     return {};
   }
 
-  return RoundedToInt(treeOwnerAsWin->GetSize() /
-                      CSSToDevScaleForBaseWindow(treeOwnerAsWin));
+  const CSSIntSize stock = RoundedToInt(
+      treeOwnerAsWin->GetSize() / CSSToDevScaleForBaseWindow(treeOwnerAsWin));
+
+  // Camoufox: with the claimed OS's window frame, a page measures the real
+  // content area plus that frame, not the host's toolbars and decorations.
+  // From the top context's content area, so an iframe in any process reads
+  // its window's size. Stock's work stays first (timing parity; see
+  // nsScreen::PixelDepth), and browser code keeps the real size.
+  if (aCallerType != CallerType::System) {
+    if (const Maybe<CSSIntMargin>& frame =
+            nsGlobalWindowInner::ClaimedWindowFrame()) {
+      if (BrowsingContext* bc = GetBrowsingContext()) {
+        BrowsingContext* top = bc->Top();
+        const CSSIntRect content = top->GetCamouContentRect();
+        // A fullscreen window has no frame: outer is inner, as in stock.
+        if (!content.IsEmpty() && top->GetCamouFullscreen()) {
+          return content.Size();
+        }
+        if (!content.IsEmpty()) {
+          return CSSIntSize(
+              content.width + frame->left.value + frame->right.value,
+              content.height + frame->top.value + frame->bottom.value);
+        }
+      }
+    }
+  }
+  return stock;
 }
 
