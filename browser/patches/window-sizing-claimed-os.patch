diff --git a/dom/base/nsGlobalWindowInner.cpp b/dom/base/nsGlobalWindowInner.cpp
index 8492c63ccf..f6032debf7 100644
--- a/dom/base/nsGlobalWindowInner.cpp
+++ b/dom/base/nsGlobalWindowInner.cpp
@@ -3891,7 +3891,45 @@ CSSIntPoint nsGlobalWindowInner::SpoofedWindowShift(nsIGlobalObject* aGlobal) {
 
 /* static */
 CSSIntPoint nsGlobalWindowInner::SpoofedScreenShift(nsIGlobalObject* aGlobal) {
-  return SpoofedWindowShift(aGlobal);
+  CSSIntPoint shift = SpoofedWindowShift(aGlobal);
+  // With the claimed OS's frame, the top page's content sits at the frame's
+  // top-left inset from the window's position, not where the real window's
+  // chrome put it. One shift for the whole window: an iframe's screen points
+  // keep their offset inside the top page.
+  // A fullscreen window has no frame.
+  const Maybe<CSSIntMargin>& frame = ClaimedWindowFrame();
+  nsPIDOMWindowInner* inner = aGlobal ? aGlobal->GetAsInnerWindow() : nullptr;
+  if (frame && inner) {
+    if (BrowsingContext* bc = inner->GetBrowsingContext()) {
+      BrowsingContext* top = bc->Top();
+      const CSSIntRect content = top->GetCamouContentRect();
+      if (!content.IsEmpty()) {
+        const bool fullscreen = top->GetCamouFullscreen();
+        shift += CSSIntPoint((fullscreen ? 0 : frame->left.value) - content.x,
+                             (fullscreen ? 0 : frame->top.value) - content.y);
+      }
+    }
+  }
+  return shift;
+}
+
+/* static */
+const Maybe<CSSIntMargin>& nsGlobalWindowInner::ClaimedWindowFrame() {
+  // Read once: the config never changes in a process.
+  MOZ_ASSERT(NS_IsMainThread());
+  static const Maybe<CSSIntMargin> sFrame = []() -> Maybe<CSSIntMargin> {
+    const auto left = MaskConfig::GetUint32("window.frameLeft");
+    const auto top = MaskConfig::GetUint32("window.frameTop");
+    const auto right = MaskConfig::GetUint32("window.frameRight");
+    const auto bottom = MaskConfig::GetUint32("window.frameBottom");
+    if (!left && !top && !right && !bottom) {
+      return Nothing();
+    }
+    return Some(CSSIntMargin(int32_t(top.value_or(0)), int32_t(right.value_or(0)),
+                             int32_t(bottom.value_or(0)),
+                             int32_t(left.value_or(0))));
+  }();
+  return sFrame;
 }
 
