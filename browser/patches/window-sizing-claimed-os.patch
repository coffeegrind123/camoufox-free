diff --git a/dom/ipc/BrowserParent.cpp b/dom/ipc/BrowserParent.cpp
index 8b4018fefd..51b9c42ae9 100644
--- a/dom/ipc/BrowserParent.cpp
+++ b/dom/ipc/BrowserParent.cpp
@@ -1192,6 +1192,33 @@ void BrowserParent::UpdateDimensions(const LayoutDeviceIntRect& rect,
     mChromeOffset = chromeOffset;
 
     (void)SendUpdateDimensions(GetDimensionInfo());
+    UpdateCamouContentRect();
+  }
+}
+
+void BrowserParent::UpdateCamouContentRect() {
+  // Camoufox: where a top-level browser's content area really sits in its
+  // window, and its size, in unscaled CSS pixels: what a page's window frame
+  // (outerWidth - innerWidth, mozInnerScreenX - screenX) is measured from when
+  // the frame is reported as the claimed OS's. Only this process knows the
+  // window; an iframe in any process reads it from the top context.
+  if (GetBrowserBridgeParent()) {
+    return;
+  }
+  CanonicalBrowsingContext* bc = GetBrowsingContext();
+  if (!bc || !bc->IsTop()) {
+    return;
+  }
+  const CSSIntRect content(
+      RoundedToInt(LayoutDevicePoint(mClientOffset + mChromeOffset) /
+                   mDefaultScale),
+      RoundedToInt(mDimensions / mDefaultScale));
+  if (bc->GetCamouContentRect() != content) {
+    (void)bc->SetCamouContentRect(content);
+  }
+  const bool fullscreen = mSizeMode == nsSizeMode_Fullscreen;
+  if (bc->GetCamouFullscreen() != fullscreen) {
+    (void)bc->SetCamouFullscreen(fullscreen);
   }
 }
 
