+// static
+CSSIntPoint Event::SpoofedScreenShift(nsPresContext* aPresContext,
+                                      WidgetEvent* aEvent) {
+  // The cases where GetScreenCoords() measures the real window: pointer lock,
+  // or an event that came from a widget.
+  if (!aPresContext) {
+    return {};
+  }
+  if (!PointerLockManager::IsLocked()) {
+    const WidgetGUIEvent* guiEvent =
+        aEvent && aEvent->DOMEventSupportsCoords() ? aEvent->AsGUIEvent()
+                                                   : nullptr;
+    if (!guiEvent || !guiEvent->mWidget) {
+      return {};
+    }
+  }
+  return nsGlobalWindowInner::SpoofedScreenShift(
+      aPresContext->Document()->GetScopeObject());
+}
