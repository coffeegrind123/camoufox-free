+/* static */
+bool nsGlobalWindowInner::IsPagePopup(nsPIDOMWindowInner* aInner) {
+  // The spec's "is popup", which window.open with popup features requests:
+  // such a window is the page's, never one CamoufoxWindow.sys.mjs placed
+  // (it skips windows with initialOpenWindowInfo). A page's window.open
+  // without popup features opens a tab in a placed window.
+  BrowsingContext* bc = aInner ? aInner->GetBrowsingContext() : nullptr;
+  return !bc || bc->Top()->GetIsPopupRequested();
+}
+
+/* static */
+CSSIntPoint nsGlobalWindowInner::SpoofedWindowShift(nsIGlobalObject* aGlobal) {
+  const auto x = MaskConfig::GetInt32("window.screenX");
+  const auto y = MaskConfig::GetInt32("window.screenY");
+  if (!x && !y) {
+    return {};
+  }
+  nsPIDOMWindowInner* inner = aGlobal ? aGlobal->GetAsInnerWindow() : nullptr;
+  nsGlobalWindowOuter* outer =
+      inner ? Cast(inner)->GetOuterWindowInternal() : nullptr;
+  if (!outer || IsPagePopup(inner)) {
+    return {};
+  }
+  IgnoredErrorResult rv;
+  const CSSIntPoint real = outer->GetScreenXY(CallerType::System, rv);
+  if (rv.Failed()) {
+    return {};
+  }
+  return CSSIntPoint(x ? *x - real.x : 0, y ? *y - real.y : 0);
+}
+
+/* static */
+CSSIntPoint nsGlobalWindowInner::SpoofedScreenShift(nsIGlobalObject* aGlobal) {
+  return SpoofedWindowShift(aGlobal);
 }
 
