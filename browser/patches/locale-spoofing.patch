+#include "MaskConfig.hpp"
 
 namespace mozilla::intl {
 
 using namespace intl::LanguageTagLimits;
 
+// Camoufox: default-locale hooks (see Locale.h).
+
+// Each value is leaked: ICU and worker threads may still be reading the
+// previous one, and a process is given a handful at most.
+static std::atomic<const char*> sContextLocale{nullptr};
+
+void Locale::SetContextLocale(const char* aLocale) {
+  if (!aLocale || !*aLocale) {
+    sContextLocale = nullptr;
+    return;
+  }
+  const char* current = sContextLocale;
+  if (!current || strcmp(current, aLocale)) {
+    sContextLocale = (new std::string(aLocale))->c_str();
+  }
+}
+
+bool Locale::HasContextLocale() { return sContextLocale != nullptr; }
+
+const char* Locale::GetCamouLocale() {
+  if (const char* context = sContextLocale) {
+    return context;
+  }
+  static const std::optional<std::string> sLocale =
+      []() -> std::optional<std::string> {
+    if (auto value = MaskConfig::GetString("navigator.language")) {
+      return value;
+    }
+    auto lang = MaskConfig::GetString("locale:language");
+    auto region = MaskConfig::GetString("locale:region");
+    if (lang && region) {
+      return lang.value() + "-" + region.value();
+    }
+    return std::nullopt;
+  }();
+  return sLocale ? sLocale->c_str() : nullptr;
+}
+
+const char* Locale::GetDefaultLocale() {
+  // In Camoufox, GetDefaultLocale is defined outside the header
+  // to access MaskConfig.
+  if (auto value = GetCamouLocale())
+    return value;
+  return uloc_getDefault();
+}
